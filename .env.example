# Copy to .env at the repo root. Every value below has a working default for
# local development, so the app runs with no .env at all.

# --- Backend -----------------------------------------------------------------

# Generate one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-in-production

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default. Point this at Postgres and nothing else has to change:
#   DATABASE_URL=postgres://user:password@localhost:5432/turbo_notes
# DATABASE_URL=sqlite:///db.sqlite3

# --- Frontend ----------------------------------------------------------------

# Where the Next.js server reaches Django. The browser never uses this: it
# only ever talks to Next, which is why the API needs no CORS configuration.
DJANGO_API_URL=http://127.0.0.1:8000
